# -------------------------------------------------------------
# SocialPilot Backend Environment Configuration
# -------------------------------------------------------------

# General App Settings
PROJECT_NAME="SocialPilot API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://socialpilot-frontend-indol.vercel.app"


# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=socialpilot_db
SQLALCHEMY_DATABASE_URI=postgresql://postgres:postgres@localhost:5433/socialpilot_db

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=socialpilot_mongo

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security Settings (Placeholders for future Auth step)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-0987654321
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Email Settings
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@socialpilot.test
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=True
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=""

# OAuth 2.0 Provider Credentials
META_CLIENT_ID=""
META_CLIENT_SECRET=""
META_REDIRECT_URI="http://127.0.0.1:8000/api/v1/oauth/facebook/callback"
INSTAGRAM_REDIRECT_URI="http://127.0.0.1:8000/api/v1/oauth/instagram/callback"

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
